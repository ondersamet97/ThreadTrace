{
  "manifest_version": 3,
  "name": "ThreadTrace",
  "version": "0.9.17",
  "description": "Add context to people on Threads and explore what happened next with Muse.",
  "permissions": [
    "storage",
    "sidePanel",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://www.threads.net/*",
    "https://www.threads.com/*"
  ],
  "optional_host_permissions": [
    "https://api.meta.ai/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "ThreadTrace",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "options_page": "src/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.threads.net/*",
        "https://www.threads.com/*"
      ],
      "js": [
        "src/i18n.js",
        "src/model.js",
        "src/client.js",
        "src/research-adapter.js",
        "src/icons.js",
        "src/injector.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
